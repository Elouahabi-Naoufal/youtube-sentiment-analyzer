{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analyzer",
  "version": "0.1.0",
  "description": "Analyze the sentiment of YouTube comments using your MLOps model.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze sentiment"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
